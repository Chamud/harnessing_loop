# Credentials for the model clients. The harness process reads these; the
# sandbox never sees them. Copy to .env and load it in your own shell or
# process manager; the library does not read .env files itself.

# Direct API client (pip install "harnessing_loop[anthropic]")
ANTHROPIC_API_KEY=

# Cloud-hosted client (pip install "harnessing_loop[bedrock]")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
